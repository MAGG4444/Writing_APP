{
  "version": 1,
  "prompts": [
    {
      "id": "planner_prompt",
      "file": null,
      "stage": "planning",
      "paths": ["fast_draft", "standard_chapter", "polished_chapter"],
      "cost_level": "medium",
      "model_tier": "planning",
      "use_when": ["Generate current chapter outline."],
      "avoid_when": ["Writing final prose directly."],
      "required_inputs": ["project_context", "previous_summaries", "user_instruction"],
      "outputs": ["chapter_outline"],
      "tags": ["outline", "planning", "chapter"]
    },
    {
      "id": "scene_outline_prompt",
      "file": null,
      "stage": "planning",
      "paths": ["fast_draft", "standard_chapter", "polished_chapter"],
      "cost_level": "medium",
      "model_tier": "planning",
      "use_when": ["Split a chapter outline into scene units."],
      "avoid_when": ["Reviewing finished prose."],
      "required_inputs": ["chapter_outline", "target_word_count"],
      "outputs": ["scene_outline"],
      "tags": ["scene", "outline", "planning"]
    },
    {
      "id": "writer_prompt",
      "file": null,
      "stage": "generation",
      "paths": [],
      "cost_level": "high",
      "model_tier": "writing",
      "use_when": ["Legacy single-pass chapter drafting."],
      "avoid_when": ["Scene-based generation paths."],
      "required_inputs": ["project_context", "chapter_outline", "user_instruction"],
      "outputs": ["chapter_content"],
      "tags": ["legacy", "chapter", "prose"]
    },
    {
      "id": "scene_writer_prompt",
      "file": null,
      "stage": "generation",
      "paths": ["fast_draft", "standard_chapter", "polished_chapter"],
      "cost_level": "high",
      "model_tier": "writing",
      "use_when": ["Generate one scene body."],
      "avoid_when": ["Writing review reports."],
      "required_inputs": ["project_context", "chapter_outline", "scene"],
      "outputs": ["scene_content", "chapter_end_marker"],
      "tags": ["scene", "prose", "fiction"]
    },
    {
      "id": "expand_scene_prompt",
      "file": null,
      "stage": "adjustment",
      "paths": ["standard_chapter", "polished_chapter"],
      "cost_level": "high",
      "model_tier": "writing",
      "use_when": ["Scene is materially below target word count."],
      "avoid_when": ["Fast draft mode."],
      "required_inputs": ["scene", "scene_content", "target_word_count"],
      "outputs": ["adjusted_scene_content"],
      "tags": ["scene", "expand", "word_count"]
    },
    {
      "id": "compress_scene_prompt",
      "file": null,
      "stage": "adjustment",
      "paths": ["standard_chapter", "polished_chapter"],
      "cost_level": "medium",
      "model_tier": "editing",
      "use_when": ["Scene is materially above target word count."],
      "avoid_when": ["Fast draft mode."],
      "required_inputs": ["scene", "scene_content", "target_word_count"],
      "outputs": ["adjusted_scene_content"],
      "tags": ["scene", "compress", "word_count"]
    },
    {
      "id": "continue_chapter_prompt",
      "file": null,
      "stage": "generation",
      "paths": ["fast_draft", "standard_chapter", "polished_chapter"],
      "cost_level": "high",
      "model_tier": "writing",
      "use_when": ["LLM output is truncated or missing chapter end marker."],
      "avoid_when": ["Initial scene generation."],
      "required_inputs": ["project_context", "chapter_outline", "content_tail", "remaining_word_count"],
      "outputs": ["continuation_content", "chapter_end_marker"],
      "tags": ["continue", "truncation", "completion"]
    },
    {
      "id": "chapter_completion_auditor_prompt",
      "file": null,
      "stage": "audit",
      "paths": ["fast_draft", "standard_chapter", "polished_chapter"],
      "cost_level": "low",
      "model_tier": "cheap",
      "use_when": ["Check whether generated content is complete."],
      "avoid_when": ["Style review."],
      "required_inputs": ["chapter_content"],
      "outputs": ["completion_audit"],
      "tags": ["audit", "completion", "truncation"]
    },
    {
      "id": "chapter_completion_repair_prompt",
      "file": null,
      "stage": "repair",
      "paths": ["standard_chapter", "polished_chapter"],
      "cost_level": "high",
      "model_tier": "writing",
      "use_when": ["Completion auditor reports unfinished ending."],
      "avoid_when": ["Reviewer-only paths."],
      "required_inputs": ["chapter_content", "completion_audit"],
      "outputs": ["repaired_chapter_content"],
      "tags": ["repair", "completion", "ending"]
    },
    {
      "id": "editor_prompt",
      "file": null,
      "stage": "editing",
      "paths": [],
      "cost_level": "medium",
      "model_tier": "editing",
      "use_when": ["Rewrite selected text."],
      "avoid_when": ["Full chapter generation."],
      "required_inputs": ["selected_text", "project_context"],
      "outputs": ["rewritten_text"],
      "tags": ["rewrite", "selection", "editing"]
    },
    {
      "id": "summarizer_prompt",
      "file": null,
      "stage": "memory",
      "paths": ["fast_draft", "standard_chapter", "polished_chapter"],
      "cost_level": "low",
      "model_tier": "cheap",
      "use_when": ["Summarize generated chapter into memory."],
      "avoid_when": ["Drafting prose."],
      "required_inputs": ["chapter_content"],
      "outputs": ["chapter_summary"],
      "tags": ["memory", "summary", "chapter"]
    },
    {
      "id": "consistency_checker_prompt",
      "file": null,
      "stage": "review",
      "paths": [],
      "cost_level": "medium",
      "model_tier": "review",
      "use_when": ["Manual consistency check."],
      "avoid_when": ["Default chapter generation."],
      "required_inputs": ["chapter_content", "project_context", "memory"],
      "outputs": ["consistency_report"],
      "tags": ["consistency", "review", "world"]
    },
    {
      "id": "quality_review_prompt",
      "file": null,
      "stage": "review",
      "paths": ["standard_chapter", "polished_chapter"],
      "cost_level": "medium",
      "model_tier": "review",
      "use_when": ["Review full chapter quality."],
      "avoid_when": ["Fast draft mode."],
      "required_inputs": ["chapter_content", "scene_outline", "project_context", "craft_rules"],
      "outputs": ["quality_review_report"],
      "tags": ["quality", "review", "scene", "style"]
    },
    {
      "id": "transition_review_prompt",
      "file": null,
      "stage": "review",
      "paths": ["standard_chapter", "polished_chapter"],
      "cost_level": "medium",
      "model_tier": "review",
      "use_when": ["Review scene transitions."],
      "avoid_when": ["Fast draft mode."],
      "required_inputs": ["chapter_content", "scene_outline", "craft_rules"],
      "outputs": ["transition_review_report"],
      "tags": ["transition", "review", "pacing"]
    },
    {
      "id": "editorial_suggestions_prompt",
      "file": null,
      "stage": "report",
      "paths": ["polished_chapter"],
      "cost_level": "medium",
      "model_tier": "review",
      "use_when": ["Create author-facing editorial suggestions."],
      "avoid_when": ["Internal debug reports."],
      "required_inputs": ["chapter_content", "quality_review_report", "transition_review_report", "style", "selected_craft_rules"],
      "outputs": ["editorial_suggestions_report"],
      "tags": ["editorial", "author_report", "review"]
    },
    {
      "id": "project_materials_prompt",
      "file": null,
      "stage": "planning",
      "paths": [],
      "cost_level": "medium",
      "model_tier": "planning",
      "use_when": ["Develop inspiration into project materials."],
      "avoid_when": ["Chapter body drafting."],
      "required_inputs": ["inspiration", "project_materials"],
      "outputs": ["project_materials_draft"],
      "tags": ["materials", "inspiration", "planning"]
    }
  ]
}
